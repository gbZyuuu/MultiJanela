<UserControl FontSize="{DynamicResource Font14}" FontFamily="{DynamicResource InterfaceFontFamily}" x:Class="RobloxMultiManager.CpuGlobalSlider" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RobloxMultiManager">
    <UserControl.Resources>
        <ControlTemplate x:Key="CpuTrackButton" TargetType="RepeatButton">
            <Border Background="{TemplateBinding Background}" Height="4" CornerRadius="2" VerticalAlignment="Center" />
        </ControlTemplate>
        <Style x:Key="CpuHomeSlider" TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="32" Background="Transparent">
                            <Border x:Name="FocusRing" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Accent}" Opacity="0" Margin="-6,0" />
                            <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Background="{DynamicResource Accent}" Template="{StaticResource CpuTrackButton}" Focusable="False" IsTabStop="False" /></Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="18" Height="18" Cursor="Hand">
                                        <Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{DynamicResource Accent}" /></ControlTemplate></Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Background="{DynamicResource Hairline}" Template="{StaticResource CpuTrackButton}" Focusable="False" IsTabStop="False" /></Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Opacity" Value="1" /></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border BorderBrush="{DynamicResource Hairline}" BorderThickness="0" CornerRadius="6" Padding="0,9" Background="Transparent" ToolTip="{local:Tr 'Teto de CPU por processo. 100% significa sem limite. Salvo automaticamente; limites individuais são preservados.'}">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" MinWidth="58" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{local:Tr 'CPU global'}" FontSize="{DynamicResource Font15}" FontWeight="SemiBold" />
                <TextBlock Text="{local:Tr 'Por processo'}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource Font12}" Margin="0,2,0,0" />
            </StackPanel>
            <Slider Style="{StaticResource CpuHomeSlider}" x:Name="LimitSlider" Grid.Column="1" Minimum="1" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="5" VerticalAlignment="Center" Margin="20,0" ValueChanged="LimitSlider_ValueChanged" Thumb.DragStarted="LimitSlider_DragStarted" Thumb.DragCompleted="LimitSlider_DragCompleted" AutomationProperties.Name="{local:Tr 'Limite global de CPU'}" />
            <TextBlock x:Name="ValueText" Grid.Column="2" Text="100%" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource Font19}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <TextBlock x:Name="SaveError" Grid.Row="1" Grid.ColumnSpan="3" Visibility="Collapsed" Text="{local:Tr 'Não foi possível salvar o limite. Tente novamente.'}" Foreground="{DynamicResource DangerText}" TextWrapping="Wrap" Margin="0,8,0,0" />
        </Grid>
    </Border>
</UserControl>
