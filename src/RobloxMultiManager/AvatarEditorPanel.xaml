<UserControl x:Class="RobloxMultiManager.AvatarEditorPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RobloxMultiManager" FontSize="{DynamicResource Font14}" Background="{DynamicResource SurfaceInset}">
<UserControl.Resources><Style x:Key="EditorTileStyle" TargetType="ListBoxItem" BasedOn="{StaticResource StudioTileStyle}"><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,0,10,10"/></Style><DataTemplate x:Key="AvatarItemTemplate"><StackPanel><Border Height="88" Background="{DynamicResource SurfaceRaised}" CornerRadius="8"><Image Source="{Binding ThumbnailUrl, IsAsync=True}" Stretch="Uniform"/></Border><TextBlock Text="{Binding Name}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></StackPanel></DataTemplate></UserControl.Resources>
<Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel Margin="0,0,0,12"><Button x:Name="ExpandEditor" DockPanel.Dock="Right" Content="{local:Tr 'Ampliar editor'}" Click="Expand_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/><Button x:Name="Refresh" DockPanel.Dock="Right" Content="{local:Tr 'Atualizar'}" Style="{StaticResource GhostButtonStyle}" Click="Refresh_Click"/><StackPanel Orientation="Horizontal"><TextBlock Text="{local:Tr 'Editor de avatar'}" FontSize="{DynamicResource Font21}" FontWeight="SemiBold"/><TextBlock x:Name="AccountCaption" Foreground="{DynamicResource TextMuted}" Margin="12,6,0,0"/></StackPanel></DockPanel>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition x:Name="PreviewColumn" Width="220"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="{DynamicResource SurfaceInset}" CornerRadius="16" BorderBrush="{DynamicResource HairlineSoft}" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Image x:Name="Portrait" Stretch="Uniform" Margin="10"/><local:AvatarViewport x:Name="Preview3D"/><StackPanel Grid.Row="1" Margin="12"><TextBlock x:Name="PreviewHint" Visibility="Collapsed" Text="{local:Tr 'Arraste para girar · role para aproximar'}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" FontSize="{DynamicResource Font12}"/><TextBlock x:Name="PreviewStatus" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="{DynamicResource Font14}"/><Button Content="{local:Tr 'Atualizar prévia'}" Click="Preview_Click" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel></Grid></Border>
<Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel Margin="0,0,0,10"><Button x:Name="ItemsTab" Content="{local:Tr 'Seu inventário'}" Click="Items_Click" Style="{StaticResource PortalTabStyle}" local:NavigationState.Active="True"/><Button x:Name="WornTab" Content="{local:Tr 'Itens do visual'}" Click="Worn_Click" Style="{StaticResource PortalTabStyle}"/><Button x:Name="BodyTab" Content="{local:Tr 'Corpo e cores'}" Click="Body_Click" Style="{StaticResource PortalTabStyle}"/></WrapPanel>
<Grid x:Name="ItemsArea" Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ComboBox x:Name="Category" DisplayMemberPath="Name" SelectionChanged="Category_Changed" Margin="0,0,0,10" MinHeight="38"/>
<ListBox x:Name="Inventory" Grid.Row="1" SelectionMode="Extended" Style="{StaticResource CardListStyle}" ItemContainerStyle="{StaticResource EditorTileStyle}" ItemTemplate="{StaticResource AvatarItemTemplate}"><ListBox.ItemsPanel><ItemsPanelTemplate><local:SessionTilePanel MinimumItemWidth="130" ItemHeight="148"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
<Button x:Name="More" Grid.Row="2" Content="{local:Tr 'Carregar mais'}" Click="More_Click" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left" Margin="0,4,0,0" Visibility="Collapsed"/>
</Grid>
<Grid x:Name="WornArea" Grid.Row="1" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<ListBox x:Name="Equipped" SelectionMode="Extended" Style="{StaticResource CardListStyle}" ItemContainerStyle="{StaticResource EditorTileStyle}"><ListBox.ItemsPanel><ItemsPanelTemplate><local:SessionTilePanel MinimumItemWidth="142" ItemHeight="196"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Grid><Grid.RowDefinitions><RowDefinition Height="96"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="{DynamicResource SurfaceRaised}" CornerRadius="8"><Image Source="{Binding ThumbnailUrl, IsAsync=True}" Stretch="Uniform"/></Border><TextBlock Grid.Row="1" Text="{Binding Name}" Margin="0,6,0,6" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><Button Grid.Row="2" Content="{local:Tr 'Remover do visual'}" Click="RemoveItem_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="8,0" FontSize="{DynamicResource Font12}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
<Button x:Name="Remove" Grid.Row="1" Content="{local:Tr 'Remover selecionados'}" Click="Remove_Click" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left" Margin="0,8,0,0"/></Grid>
<ScrollViewer x:Name="BodyArea" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{local:Tr 'Tipo do avatar'}" FontWeight="SemiBold" Margin="0,0,0,8"/><ComboBox x:Name="RigType" SelectionChanged="Rig_Changed" Margin="0,0,0,16"/><TextBlock Text="{local:Tr 'Cores do corpo'}" FontWeight="SemiBold" Margin="0,0,0,12"/><UniformGrid x:Name="ColorsForm" Columns="2"/><TextBlock Text="{local:Tr 'Proporções'}" FontWeight="SemiBold" Margin="0,20,0,12"/><StackPanel x:Name="ScalesForm"/><Button x:Name="ApplyBody" Content="{local:Tr 'Aplicar corpo e cores'}" Click="ApplyBody_Click" HorizontalAlignment="Left" Margin="0,16,0,10" IsEnabled="False"/></StackPanel></ScrollViewer>
</Grid></Grid>
<Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="Equip" Content="{local:Tr 'Adicionar ao visual'}" Click="Equip_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/><TextBlock x:Name="Status" Grid.Column="1" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="{DynamicResource TextMuted}" Margin="0,0,12,0" VerticalAlignment="Center"/><WrapPanel Grid.Column="2"><Button x:Name="Apply" Content="{local:Tr 'Aplicar itens'}" Click="Apply_Click" IsEnabled="False"/><Button x:Name="Stop" Content="{local:Tr 'Cancelar'}" Click="Stop_Click" Style="{StaticResource GhostButtonStyle}" Visibility="Collapsed" Margin="8,0,0,0"/></WrapPanel></Grid>
</Grid></UserControl>