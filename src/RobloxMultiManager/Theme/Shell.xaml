<!--
    Shell components.

    The old window was one screen: two DataGrid cards side by side, a splitter, and a
    permanent log panel, inside the native Windows title bar. Everything competed for
    the same space and every list looked like a spreadsheet.

    This is a different structure. Borderless window with its own chrome, a rail that
    expands on hover, one page at a time, and lists made of cards instead of rows.

    Navigation is a restyled TabControl on purpose. It gives page switching with zero
    code-behind, so the redesign cannot break the launch, guard and monitor logic that
    took several versions to get right.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The palette is merged here as well as in App.xaml. A StaticResource inside a
         standalone dictionary is resolved while that dictionary is parsed, so it
         cannot see keys that only exist in a sibling merged dictionary. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Palette.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ==================================================================
         Window chrome
         ================================================================== -->
    <Style x:Key="ChromeButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Root" Background="{TemplateBinding Background}">
                        <Path Width="10"
                              Height="10"
                              Stretch="None"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="{TemplateBinding Tag}"
                              Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="1.2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverOverlay}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Close gets the destructive hover; the other two stay neutral. -->
    <Style x:Key="ChromeCloseButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource ChromeButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Root" Background="{TemplateBinding Background}">
                        <Path Width="10"
                              Height="10"
                              Stretch="None"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="{TemplateBinding Tag}"
                              Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="1.2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#B3303D" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <PathGeometry x:Key="GlyphMinimize" Figures="M 0 5 H 10" />
    <PathGeometry x:Key="GlyphMaximize" Figures="M 0.5 0.5 H 9.5 V 9.5 H 0.5 Z" />
    <PathGeometry x:Key="GlyphClose" Figures="M 0.6 0.6 L 9.4 9.4 M 9.4 0.6 L 0.6 9.4" />

    <PathGeometry x:Key="IconHome"
                  Figures="M 1.8 6.2 L 7 1.8 L 12.2 6.2 V 12 H 8.6 V 8.6 H 5.4 V 12 H 1.8 Z" />
    <PathGeometry x:Key="IconConsole"
                  Figures="M 1.6 2.6 H 12.4 V 11.4 H 1.6 Z M 4 6 L 6 7.6 L 4 9.2 M 7.4 9.4 H 10" />

    <!-- ==================================================================
         Navigation rail. Collapsed it is icons only; hovering the rail
         expands it, so the labels cost nothing until they are wanted.
         ================================================================== -->
    <Style x:Key="RailItemStyle" TargetType="{x:Type TabItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="Height" Value="44" />
        <Setter Property="FontSize" Value="{DynamicResource Font13}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Grid>
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="10"
                                Margin="8,2" />
                        <!-- Active marker: a short bar on the left edge, not a
                             full-height selection block. -->
                        <Border x:Name="Marker"
                                Width="3"
                                Height="20"
                                CornerRadius="2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{DynamicResource AccentGradient}"
                                Opacity="0" />
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="21,0,0,0">
                            <Path x:Name="Glyph"
                                  Width="14"
                                  Height="14"
                                  Stretch="None"
                                  VerticalAlignment="Center"
                                  Data="{TemplateBinding Tag}"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.4"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                            <!-- Hidden while the rail is collapsed. Relying on the
                                 62px width to clip it left the first two letters of
                                 every label showing. -->
                            <ContentPresenter x:Name="Label"
                                              ContentSource="Header"
                                              VerticalAlignment="Center"
                                              Margin="14,0,0,0"
                                              Opacity="0" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- The nearest Grid ancestor of a rail item is the rail's
                             hover surface, so one binding reveals every label at the
                             same moment the rail widens. -->
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Grid}}}"
                                     Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Label"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Label"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.10" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverOverlay}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSurface}" />
                            <Setter TargetName="Marker" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The rail itself. Width animates on hover, and pages fade in when selected so
        switching reads as movement rather than a repaint.
    -->
    <Style x:Key="ShellTabStyle" TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="Rail"
                                Width="62"
                                Background="{DynamicResource SurfaceGlass}"
                                BorderBrush="{DynamicResource GlassBorder}"
                                BorderThickness="0,0,1,0"
                                ClipToBounds="True">
                            <!-- A transparent Grid fills the rail, so hovering any
                                 part of it counts, not only the buttons. It is also
                                 the ancestor the labels bind their reveal to. -->
                            <Grid Background="Transparent">
                                <StackPanel IsItemsHost="True" Margin="0,10,0,0" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Background="Transparent">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"
                                              Margin="22">
                                <ContentPresenter.RenderTransform>
                                    <TranslateTransform x:Name="Slide" />
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="SelectionChanged">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="PART_SelectedContentHost"
                                                     Storyboard.TargetProperty="Opacity"
                                                     From="0" To="1" Duration="0:0:0.16" />
                                    <DoubleAnimation Storyboard.TargetName="Slide"
                                                     Storyboard.TargetProperty="Y"
                                                     From="10" To="0" Duration="0:0:0.2" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <Trigger SourceName="Rail" Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Rail"
                                                         Storyboard.TargetProperty="Width"
                                                         To="196" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Rail"
                                                         Storyboard.TargetProperty="Width"
                                                         To="62" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================================
         Stats. A number with a gradient underline instead of a number
         between vertical dividers.
         ================================================================== -->
    <Style x:Key="StatValueStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{DynamicResource Font34}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>

    <Style x:Key="StatLabelStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{DynamicResource Font11}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <Style x:Key="StatRuleStyle" TargetType="{x:Type Border}">
        <Setter Property="Height" Value="3" />
        <Setter Property="Width" Value="30" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Background" Value="{DynamicResource AccentGradient}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,10,0,0" />
    </Style>

    <Style x:Key="StatCardStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource SurfaceGlass}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="18,16" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Compact stat badges for the redesigned header. Smaller footprint than
         StatCardStyle so four of them fit inline beside the activate button. -->
    <Style x:Key="StatBadgeStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource SurfaceGlass}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="StatBadgeValueStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{DynamicResource Font13}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StatBadgeLabelStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{DynamicResource Font10}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="4,0,0,0" />
    </Style>

    <!-- ==================================================================
         Sidebar navigation tabs. Discord/VS Code style vertical nav with
         icon-only buttons, active indicator bar and hover glow.
    ================================================================== -->
    <Style x:Key="SidebarTabStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <!-- Active indicator bar (hidden by default) -->
                        <Border x:Name="ActiveBar"
                                Width="3" Height="24"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                CornerRadius="0,2,2,0"
                                Background="{StaticResource AccentPrimary}"
                                Opacity="0" />
                        <!-- Icon container -->
                        <Border x:Name="IconBg"
                                Width="40" Height="40"
                                CornerRadius="12"
                                Background="Transparent"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="IconBg" Property="Background" Value="{DynamicResource SurfaceGlassRaised}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SidebarTabActiveStyle" TargetType="{x:Type Button}"
           BasedOn="{StaticResource SidebarTabStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Border Width="3" Height="24"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                CornerRadius="0,2,2,0"
                                Background="{StaticResource AccentPrimary}" />
                        <Border Width="40" Height="40"
                                CornerRadius="12"
                                Background="{DynamicResource SurfaceGlassRaised}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SidebarIconOnlyStyle" TargetType="{x:Type Button}"
           BasedOn="{StaticResource SidebarTabStyle}">
        <Setter Property="Opacity" Value="0.6" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1.0" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Vertical divider between tool columns in the bottom-right panel. -->
    <Style x:Key="VDividerStyle" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Hairline}" />
        <Setter Property="Margin" Value="0,4" />
    </Style>

    <!-- ==================================================================
         Card lists. These replace the two DataGrids, which is the change
         that makes the app stop looking like a spreadsheet.
         ================================================================== -->
    <Style x:Key="CardListStyle" TargetType="{x:Type ListBox}">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ScrollViewer CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}" Focusable="False"><ItemsPresenter/></ScrollViewer></Border></ControlTemplate></Setter.Value></Setter>
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <!-- Recycling rather than the default Standard: these rows carry an image
             brush and several nested panels, so rebuilding a container per scroll
             step was measurable. Virtualisation only engages because the two
             lists now have a MaxHeight; unbounded height realises every row. -->
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,9" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <Grid>
                                    <Border x:Name="Root"
                                            Background="{DynamicResource SurfaceRaised}"
                                            BorderBrush="{DynamicResource GlassBorder}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="12,9" />
                                    <!-- Selection reads as an accent edge plus a
                                         tinted fill, so multi-select stays legible. -->
                                    <Border x:Name="Edge"
                                            Width="3"
                                            CornerRadius="2"
                                            HorizontalAlignment="Left"
                                            Margin="1,10"
                                            Background="{DynamicResource AccentGradient}"
                                            Opacity="0" />
                                    <ContentPresenter Margin="12,9" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverOverlay}" />
                                        <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource GlassBorderHover}" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Accent}" /></Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource SelectionRow}" />
                                        <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBorder}" />
                                        <Setter TargetName="Edge" Property="Opacity" Value="1" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================================
         Per-row action buttons.

         These live inside a ListBox ItemTemplate, so they act on their own row's
         DataContext. That is the whole point: the toolbar buttons they replace
         acted on "the selection", which is invisible from a toolbar and was
         being reset every time the instance list refreshed.

         They deliberately do not reuse BaseButtonStyle: at 28px a 14px glyph
         plus that template's 14px horizontal padding does not fit.
         ================================================================== -->
    <Style x:Key="RowIconButtonBaseStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceInset}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Hairline}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="9"
                            SnapsToDevicePixels="True">
                        <Path x:Name="Glyph"
                              Width="14"
                              Height="14"
                              Stretch="None"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="{TemplateBinding Tag}"
                              Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="1.4"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Accent}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Glyph" Property="Opacity" Value="0.3" />
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RowPlayButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource RowIconButtonBaseStyle}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentSurface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBorder}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentHover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RowCloseButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource RowIconButtonBaseStyle}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource DangerSurface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource DangerBorder}" />
                <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Square glyph-only button for the toolbar (reorder arrows). Same height as
         the text buttons next to it so the WrapPanel row stays flush. -->
    <Style x:Key="IconOnlyButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource RowIconButtonBaseStyle}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentSurface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBorder}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Round monogram used where an avatar would go. No network fetch, so it
         cannot stall the list or leak a request per row. -->
    <Style x:Key="MonogramStyle" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="Background" Value="{DynamicResource AccentGradient}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="EmptyStateStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
        <Setter Property="FontSize" Value="{DynamicResource Font12.5}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="PageTitleLargeStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{DynamicResource Font24}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>

    <Style x:Key="PageSubtitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{DynamicResource Font12.5}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="Margin" Value="0,5,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>
