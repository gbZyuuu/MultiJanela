<UserControl FontSize="{DynamicResource Font14}" FontFamily="{DynamicResource InterfaceFontFamily}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RobloxMultiManager.VersionsPanel" xmlns:local="clr-namespace:RobloxMultiManager">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource AccentSurface}" BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel>
                    <TextBlock Text="{local:Tr 'Versão em uso'}" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource Font14}" />
                    <TextBlock x:Name="CurrentVersionText" Text="{local:Tr 'Localizando…'}" FontSize="{DynamicResource Font23}" FontWeight="SemiBold" Margin="0,8,0,6" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="CurrentIdText" FontSize="{DynamicResource Font14}" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <TextBlock x:Name="SelectionModeText" FontSize="{DynamicResource Font14}" Foreground="{DynamicResource Success}" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource GlassBorder}" BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel>
                    <TextBlock Text="{local:Tr 'Última versão'}" Foreground="{DynamicResource Info}" FontSize="{DynamicResource Font14}" />
                    <TextBlock x:Name="LatestVersionText" Text="{local:Tr 'Consultando…'}" FontSize="{DynamicResource Font23}" FontWeight="SemiBold" Margin="0,8,0,6" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="LatestIdText" FontSize="{DynamicResource Font14}" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <TextBlock x:Name="LatestStatusText" FontSize="{DynamicResource Font14}" Foreground="{DynamicResource TextMuted}" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
        <StackPanel Grid.Row="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FilterInput" Height="36" Margin="0,0,10,0" ToolTip="{local:Tr 'Buscar versão ou hash'}" AutomationProperties.Name="{local:Tr 'Buscar versões'}" TextChanged="FilterInput_TextChanged" />
                <CheckBox Grid.Column="1" x:Name="InstalledOnlyCheck" Content="{local:Tr 'Instaladas'}" Margin="0,0,10,0" VerticalAlignment="Center" Checked="InstalledOnlyCheck_Changed" Unchecked="InstalledOnlyCheck_Changed" />
                <Button Grid.Column="2" x:Name="RefreshCatalogButton" Content="{local:Tr 'Atualizar'}" Style="{StaticResource SecondaryButtonStyle}" Click="RefreshCatalogButton_Click" />
            </Grid>
            <TextBlock x:Name="CatalogStatusText" Text="{local:Tr 'Carregando catálogo…'}" FontSize="{DynamicResource Font14}" Foreground="{DynamicResource TextFaint}" TextWrapping="Wrap" Margin="0,8,0,12" />
        </StackPanel>
        <ListBox x:Name="VersionsGrid" Grid.Row="2" Style="{StaticResource CardListStyle}" SelectionMode="Single" SelectionChanged="VersionsGrid_SelectionChanged" AutomationProperties.Name="{local:Tr 'Catálogo de versões'}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding VersionText}" FontWeight="SemiBold" FontSize="{DynamicResource Font15}" />
                            <TextBlock Text="{Binding VersionId}" FontSize="{DynamicResource Font14}" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding VersionId}" />
                            <TextBlock Text="{Binding WhenText}" FontSize="{DynamicResource Font14}" Foreground="{DynamicResource TextFaint}" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StateText}" FontSize="{DynamicResource Font14}" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding SignatureText}" FontSize="{DynamicResource Font14}" HorizontalAlignment="Right" Margin="0,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SignatureState}" Value="valid">
                                                <Setter Property="Foreground" Value="{DynamicResource Success}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SignatureState}" Value="invalid">
                                                <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <Expander x:Name="VersionAdvancedExpander" Header="{local:Tr 'Canal e download por hash'}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource Font14}">
                <Border Background="{DynamicResource SurfaceInset}" CornerRadius="12" Padding="14" Margin="0,10,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{local:Tr 'Canal'}" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" Margin="0,0,10,0" />
                            <TextBox Grid.Column="1" x:Name="ChannelInput" Text="LIVE" Margin="0,0,10,0" />
                            <Button Grid.Column="2" x:Name="CheckButton" Content="{local:Tr 'Verificar'}" Style="{StaticResource SecondaryButtonStyle}" Click="CheckButton_Click" />
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="HashInput" ToolTip="{local:Tr 'version- seguido do hash de deployment'}" AutomationProperties.Name="{local:Tr 'Hash de deployment'}" KeyDown="HashInput_KeyDown" Margin="0,0,10,0" />
                            <Button Grid.Column="1" x:Name="DownloadHashButton" Content="{local:Tr 'Baixar hash'}" Click="DownloadHashButton_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Expander>
            <Border x:Name="DownloadPanel" Background="{DynamicResource SurfaceInset}" CornerRadius="12" Padding="14" Margin="0,10,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock x:Name="DownloadStatusText" FontSize="{DynamicResource Font14}" TextTrimming="CharacterEllipsis" />
                        <ProgressBar x:Name="DownloadProgressBar" Minimum="0" Maximum="1" Height="4" Margin="0,10,0,8" />
                        <TextBlock x:Name="DownloadSizeText" FontSize="{DynamicResource Font14}" Foreground="{DynamicResource TextMuted}" />
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="CancelDownloadButton" Content="{local:Tr 'Cancelar'}" Style="{StaticResource SecondaryButtonStyle}" Click="CancelDownloadButton_Click" />
                </Grid>
            </Border>
            <TextBlock x:Name="SelectionWarningText" Foreground="{DynamicResource Warning}" FontSize="{DynamicResource Font14}" TextWrapping="Wrap" Margin="0,10,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="AutomaticButton" Content="{local:Tr 'Usar automático'}" Style="{StaticResource SecondaryButtonStyle}" Click="AutomaticButton_Click" Margin="0,0,8,0" />
                <Button Grid.Column="1" x:Name="UseSelectedButton" Content="{local:Tr 'Aplicar selecionada'}" IsEnabled="False" Click="UseSelectedButton_Click" />
            </Grid>
            <WrapPanel Margin="0,8,0,0">
                <Button x:Name="RddButton" Content="{local:Tr 'Conferir no RDD'}" Style="{StaticResource GhostButtonStyle}" FontSize="{DynamicResource Font14}" Height="28" Click="RddButton_Click" />
                <Button x:Name="RemoveDownloadButton" Content="{local:Tr 'Remover baixada'}" Style="{StaticResource GhostButtonStyle}" Foreground="{DynamicResource DangerText}" IsEnabled="False" FontSize="{DynamicResource Font14}" Height="28" Click="RemoveDownloadButton_Click" />
                <Button Content="{local:Tr 'Fechar'}" Style="{StaticResource GhostButtonStyle}" FontSize="{DynamicResource Font14}" Height="28" Click="CloseButton_Click" />
            </WrapPanel>
        </StackPanel>
    </Grid>
</UserControl>