<UserControl x:Class="RobloxMultiManager.AccountPortal" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RobloxMultiManager" xmlns:web="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" FontSize="{DynamicResource Font15}">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel x:Name="PortalHeading" Visibility="Collapsed" Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="{local:Tr 'Atualizar'}" Click="Reload_Click" Style="{StaticResource GhostButtonStyle}"/><TextBlock Text="{local:Tr 'Sua conta, no seu espaço'}" FontSize="{DynamicResource Font21}" FontWeight="SemiBold"/></DockPanel>
    <Border x:Name="AccountToolbar" Grid.Row="1" Style="{StaticResource StudioCardStyle}" Margin="0,0,0,8" Padding="12"><StackPanel>
<Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="40" Height="40" Background="{DynamicResource SurfaceRaised}" CornerRadius="6"><Image Source="{Binding SelectedItem.PublicAvatarUrl, ElementName=Account, IsAsync=True}"/></Border><ComboBox Grid.Column="1" x:Name="Account" DisplayMemberPath="PublicName" SelectionChanged="Account_Changed" MinWidth="180" AutomationProperties.Name="{local:Tr 'Conta'}"/><Button x:Name="UseDestinationButton" Grid.Column="2" Visibility="Collapsed" Content="{local:Tr 'Usar este destino'}" Click="UseDestination_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="12,0,0,0"/></Grid>
        <WrapPanel x:Name="PortalTabs"><Button x:Name="OnlineTab" Content="{local:Tr 'Amigos online'}" Click="OnlineFriends_Click" Style="{StaticResource PortalTabStyle}"/><Button x:Name="OutfitsTab" Content="{local:Tr 'Roupas salvas'}" Click="SavedOutfits_Click" Style="{StaticResource PortalTabStyle}"/><Button x:Name="FriendsTab" Content="{local:Tr 'Gerenciar amigos'}" Click="Friends_Click" Style="{StaticResource PortalTabStyle}"/><Button x:Name="AvatarTab" Content="{local:Tr 'Editor de avatar'}" Click="Avatar_Click" Style="{StaticResource PortalTabStyle}"/><Button x:Name="MoreTab" Content="{local:Tr 'Mais opções'}" Style="{StaticResource PortalTabStyle}" Click="More_Click"><Button.ContextMenu><ContextMenu><MenuItem Header="{local:Tr 'Comunidades'}" Click="Groups_Click"/><MenuItem Header="{local:Tr 'Privacidade'}" Click="Privacy_Click"/><MenuItem Header="{local:Tr 'Segurança e sessões'}" Click="Security_Click"/><Separator/><MenuItem Header="{local:Tr 'Autorizar outro dispositivo'}" Click="QuickLogin_Click"/></ContextMenu></Button.ContextMenu></Button></WrapPanel>
    </StackPanel></Border>
    <TextBlock Grid.Row="2" x:Name="Status" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
    <Grid Grid.Row="3"><Border x:Name="BrowserHost" Visibility="Collapsed" BorderBrush="{DynamicResource Hairline}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource SurfaceInset}"><web:WebView2 x:Name="Browser"/></Border><Border x:Name="NativeHost" BorderBrush="{DynamicResource HairlineSoft}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource SurfaceInset}"><ContentControl x:Name="SocialHost"/></Border></Grid>
</Grid></UserControl>
