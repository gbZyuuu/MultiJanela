<Window x:Class="RobloxMultiManager.InstallationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RobloxMultiManager" Title="MultiJanela" Width="590" Height="390" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Style="{StaticResource AppWindowStyle}">
    <Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="Heading" Text="{local:Tr 'Instalar MultiJanela'}" FontSize="{DynamicResource Font28}" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Text="{local:Tr 'Instalação para este usuário. As contas e os jogos abertos serão preservados.'}" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,12,0,22"/>
        <CheckBox Grid.Row="2" x:Name="Desktop" Content="{local:Tr 'Criar atalho na área de trabalho'}"/>
        <TextBlock Grid.Row="3" x:Name="Status" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,20,0,0"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{local:Tr 'Fechar'}" Click="Cancel_Click" Style="{StaticResource GhostButtonStyle}" Margin="0,0,12,0"/><Button x:Name="ActionButton" Content="{local:Tr 'Instalar e abrir'}" Click="Action_Click" MinWidth="150"/></StackPanel>
    </Grid>
</Window>
