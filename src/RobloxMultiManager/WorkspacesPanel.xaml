<UserControl x:Class="RobloxMultiManager.WorkspacesPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RobloxMultiManager" FontSize="{DynamicResource Font14}">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18"><TextBlock Text="{local:Tr 'Suas coleções'}" FontSize="{DynamicResource Font28}" FontWeight="SemiBold"/><TextBlock Text="{local:Tr 'Contas organizadas. Aberturas prontas para repetir.'}" Foreground="{DynamicResource TextMuted}" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
        <TextBlock Grid.Row="1" x:Name="Status" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TabControl Grid.Row="2" x:Name="CollectionsTabs" Style="{StaticResource StudioTabsStyle}">
            <TabItem Header="{local:Tr 'Perfis de abertura'}"><Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*" MinWidth="280"/></Grid.ColumnDefinitions>
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Button Content="{local:Tr 'Criar perfil'}" Click="NewPreset_Click" Margin="0,0,0,12"/><ListBox x:Name="Presets" Grid.Row="1" ItemContainerStyle="{StaticResource StudioTileStyle}" Style="{StaticResource CardListStyle}" SelectionChanged="Preset_Selected"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="12"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Foreground="{DynamicResource TextMuted}" Margin="0,6,0,0"><Run Text="{Binding Accounts.Length, Mode=OneWay}"/><Run Text=" "/><Run Text="{local:Tr 'contas'}"/></TextBlock></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Grid.Row="1" x:Name="NoPresets" Text="{local:Tr 'Nenhum perfil ainda. Crie o primeiro ao lado.'}" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="14,22" VerticalAlignment="Top" IsHitTestVisible="False"/></Grid>
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource StudioCardStyle}"><StackPanel>
                    <TextBlock Text="{local:Tr 'Seu próximo lançamento'}" FontSize="{DynamicResource Font21}" FontWeight="SemiBold"/><TextBlock Text="{local:Tr 'Salva contas, ordem, destino e preferências em um único perfil.'}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,20"/>
                    <TextBlock Text="{local:Tr 'Nome do perfil'}" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="PresetName" MaxLength="80" AutomationProperties.Name="{local:Tr 'Nome do perfil de abertura'}" Margin="0,0,0,16"/>
                    <TextBlock Text="{local:Tr 'Contas deste perfil'}" Style="{StaticResource FieldLabelStyle}"/><Button Content="{local:Tr 'Escolher contas'}" Click="PickPresetAccounts_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left"/><TextBlock x:Name="PresetAccountsText" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,8,0,16"/>
                    <TextBlock Text="{local:Tr 'Destino · vazio abre a página inicial'}" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="PresetDestination" MaxLength="2048" Margin="0,0,0,16" AutomationProperties.Name="{local:Tr 'Destino do perfil'}"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{local:Tr 'Intervalo entre contas (s)'}" TextWrapping="Wrap" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="PresetDelay" Text="5"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{local:Tr 'CPU global (%)'}" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="PresetCpu" Text="100"/></StackPanel></Grid>
                    <WrapPanel Margin="0,20,0,0"><Button Content="{local:Tr 'Salvar perfil'}" Click="SavePreset_Click"/><Button x:Name="LoadPreset" IsEnabled="False" Content="{local:Tr 'Carregar perfil'}" Click="LoadPreset_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0"/><Button x:Name="DeletePreset" IsEnabled="False" Content="{local:Tr 'Excluir'}" Click="DeletePreset_Click" Style="{StaticResource GhostButtonStyle}"/></WrapPanel>
                </StackPanel></Border></ScrollViewer>
            </Grid></TabItem>
            <TabItem Header="{local:Tr 'Grupos de contas'}"><Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*" MinWidth="280"/></Grid.ColumnDefinitions>
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Button Content="{local:Tr 'Criar grupo'}" Click="NewGroup_Click" Margin="0,0,0,12"/><ListBox x:Name="Groups" Grid.Row="1" ItemContainerStyle="{StaticResource StudioTileStyle}" Style="{StaticResource CardListStyle}" SelectionChanged="Group_Selected"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="12"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Foreground="{DynamicResource TextMuted}" Margin="0,6,0,0"><Run Text="{Binding Accounts.Length, Mode=OneWay}"/><Run Text=" "/><Run Text="{local:Tr 'contas'}"/></TextBlock></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Grid.Row="1" x:Name="NoGroups" Text="{local:Tr 'Nenhum grupo ainda. Escolha as contas e dê um nome.'}" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="14,22" VerticalAlignment="Top" IsHitTestVisible="False"/></Grid>
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource StudioCardStyle}"><StackPanel><TextBlock Text="{local:Tr 'Um grupo, suas contas'}" FontSize="{DynamicResource Font21}" FontWeight="SemiBold"/><TextBlock Text="{local:Tr 'Agrupa contas para filtrar a biblioteca ou montar uma sequência rapidamente.'}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,20"/>
                    <TextBlock Text="{local:Tr 'Nome do grupo'}" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="GroupName" MaxLength="80" Margin="0,0,0,16"/><Button Content="{local:Tr 'Escolher contas'}" Click="PickGroupAccounts_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left"/><TextBlock x:Name="GroupAccountsText" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,8,0,16"/>
                    <WrapPanel><Button Content="{local:Tr 'Salvar grupo'}" Click="SaveGroup_Click"/><Button x:Name="UseGroup" IsEnabled="False" Content="{local:Tr 'Usar grupo'}" Click="UseGroup_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0"/><Button x:Name="DeleteGroup" IsEnabled="False" Content="{local:Tr 'Excluir'}" Click="DeleteGroup_Click" Style="{StaticResource GhostButtonStyle}"/></WrapPanel>
                </StackPanel></Border></ScrollViewer>
            </Grid></TabItem>
            <TabItem Header="{local:Tr 'Notas e etiquetas'}"><ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,18,0,0"><Border Style="{StaticResource StudioCardStyle}" MaxWidth="760" HorizontalAlignment="Stretch"><StackPanel>
                <TextBlock Text="{local:Tr 'Detalhes que ajudam no dia a dia'}" FontSize="{DynamicResource Font21}" FontWeight="SemiBold"/><TextBlock Text="{local:Tr 'Anotações locais para lembrar a função de cada conta. Também aparecem na busca.'}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,20"/>
                <TextBlock Text="{local:Tr 'Conta'}" Style="{StaticResource FieldLabelStyle}"/><ComboBox x:Name="Account" DisplayMemberPath="PublicName" SelectionChanged="Account_Selected" Margin="0,0,0,16" AutomationProperties.Name="{local:Tr 'Conta'}"/>
                <TextBlock Text="{local:Tr 'Etiquetas separadas por vírgula'}" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="Tags" MaxLength="1000" Margin="0,0,0,16"/>
                <TextBlock Text="{local:Tr 'Notas'}" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="Notes" MaxLength="4000" Height="130" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                <Expander Header="{local:Tr 'Campos personalizados'}" Style="{StaticResource StudioExpanderStyle}" Margin="0,16,0,16"><StackPanel Margin="0,10,0,0"><TextBlock Text="{local:Tr 'Campos personalizados: nome=valor, um por linha'}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,8"/><TextBox x:Name="Fields" MaxLength="12000" Height="100" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/></StackPanel></Expander>
                <Button Content="{local:Tr 'Salvar notas e etiquetas'}" Click="SaveMetadata_Click" HorizontalAlignment="Left"/>
            </StackPanel></Border></ScrollViewer></TabItem>
        </TabControl>
    </Grid>
</UserControl>
