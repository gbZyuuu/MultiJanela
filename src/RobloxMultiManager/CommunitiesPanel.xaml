<UserControl x:Class="RobloxMultiManager.CommunitiesPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RobloxMultiManager" FontFamily="{DynamicResource InterfaceFontFamily}" FontSize="{DynamicResource Font14}">
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,12"><Button x:Name="Refresh" DockPanel.Dock="Right" Content="{local:Tr 'Atualizar'}" Click="Refresh_Click" Style="{StaticResource GhostButtonStyle}"/><TextBlock Text="{local:Tr 'Comunidades'}" FontSize="{DynamicResource Font23}" FontWeight="SemiBold"/></DockPanel>
  <TextBlock x:Name="Status" Grid.Row="1" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,12"/>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition x:Name="ListColumn" Width="230"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBox x:Name="Search" MaxLength="100" MinHeight="38" AutomationProperties.Name="{local:Tr 'Nome ou ID da comunidade'}" ToolTip="{local:Tr 'Nome ou ID da comunidade'}" KeyDown="Search_KeyDown"/>
    <WrapPanel Grid.Row="1" Margin="0,8,0,8"><Button x:Name="Find" Content="{local:Tr 'Buscar'}" Click="Find_Click"/><Button x:Name="Mine" Content="{local:Tr 'Minhas comunidades'}" Click="Mine_Click" Style="{StaticResource GhostButtonStyle}"/></WrapPanel>
    <ListBox x:Name="Groups" Grid.Row="2" Style="{StaticResource CardListStyle}" ItemContainerStyle="{StaticResource FocusAccountRowStyle}" SelectionChanged="Group_Changed"><ListBox.ItemTemplate><DataTemplate><Grid Margin="2,6"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{DynamicResource SurfaceRaised}" CornerRadius="8" Height="36" Width="36" VerticalAlignment="Top"><Image Source="{Binding Icon}"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding Role}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource Font12}" Margin="0,5,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
    <Button Grid.Row="3" x:Name="MoreGroups" Content="{local:Tr 'Carregar mais'}" Click="MoreGroups_Click" Visibility="Collapsed" Style="{StaticResource GhostButtonStyle}" Margin="0,8,0,0"/>
   </Grid>
   <Border Grid.Column="2" Style="{StaticResource StudioCardStyle}" Padding="16"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel><TextBlock x:Name="Title" Text="{local:Tr 'Escolha uma comunidade'}" FontSize="{DynamicResource Font21}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="Summary" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,12,0,12"><Button x:Name="Join" Content="{local:Tr 'Entrar na comunidade'}" Click="Join_Click" Visibility="Collapsed"/><Button x:Name="Leave" Content="{local:Tr 'Sair da comunidade'}" Click="Leave_Click" Style="{StaticResource GhostButtonStyle}" Visibility="Collapsed"/><Button x:Name="CancelRequest" Content="{local:Tr 'Cancelar solicitação'}" Click="CancelRequest_Click" Style="{StaticResource GhostButtonStyle}" Visibility="Collapsed"/></WrapPanel>
    <TabControl x:Name="Tabs" Grid.Row="2" Style="{StaticResource StudioTabsStyle}" SelectionChanged="Tab_Changed" Visibility="Collapsed">
     <TabItem Header="{local:Tr 'Sobre'}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,0"><TextBlock Text="{local:Tr 'Aviso da comunidade'}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" Margin="0,4,0,8"/><TextBlock x:Name="Shout" TextWrapping="Wrap"/><TextBlock Text="{local:Tr 'Descrição'}" FontWeight="SemiBold" Margin="0,22,0,8"/><TextBlock x:Name="Description" TextWrapping="Wrap"/><TextBlock x:Name="Owner" Foreground="{DynamicResource TextMuted}" Margin="0,20,0,0" TextWrapping="Wrap"/></StackPanel></ScrollViewer></TabItem>
     <TabItem x:Name="MembersTab" Header="{local:Tr 'Membros'}"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ListBox x:Name="Members" Style="{StaticResource CardListStyle}" ItemContainerStyle="{StaticResource FocusAccountRowStyle}"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding Caption}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding Role}" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><Button Grid.Row="1" x:Name="MoreMembers" Content="{local:Tr 'Carregar mais'}" Click="MoreMembers_Click" Style="{StaticResource GhostButtonStyle}" Visibility="Collapsed"/><WrapPanel x:Name="MemberActions" Grid.Row="2" Margin="0,8,0,0" Visibility="Collapsed"><ComboBox x:Name="RolePicker" DisplayMemberPath="Name" MinWidth="150" MaxWidth="240" Margin="0,0,8,8"/><Button x:Name="ChangeRole" Content="{local:Tr 'Alterar cargo'}" Click="ChangeRole_Click" Margin="0,0,8,8"/><Button x:Name="RemoveMember" Content="{local:Tr 'Remover membro'}" Click="RemoveMember_Click" Style="{StaticResource GhostButtonStyle}" Margin="0,0,0,8"/></WrapPanel></Grid></TabItem>
     <TabItem Header="{local:Tr 'Cargos'}"><ListBox x:Name="Roles" Style="{StaticResource CardListStyle}" ItemContainerStyle="{StaticResource FocusAccountRowStyle}"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Members, StringFormat={}{0:N0}}" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></TabItem>
     <TabItem x:Name="RequestsTab" Header="{local:Tr 'Solicitações'}" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ListBox x:Name="Requests" Style="{StaticResource CardListStyle}" ItemContainerStyle="{StaticResource FocusAccountRowStyle}" DisplayMemberPath="Caption"/><Button Grid.Row="1" x:Name="MoreRequests" Content="{local:Tr 'Carregar mais'}" Click="MoreRequests_Click" Style="{StaticResource GhostButtonStyle}" Visibility="Collapsed"/><WrapPanel Grid.Row="2" Margin="0,8,0,0"><Button Content="{local:Tr 'Aceitar solicitação'}" Click="Accept_Click" Margin="0,0,8,8"/><Button Content="{local:Tr 'Recusar solicitação'}" Click="Decline_Click" Style="{StaticResource GhostButtonStyle}"/></WrapPanel></Grid></TabItem>
     <TabItem x:Name="ManageTab" Header="{local:Tr 'Gerenciar'}" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><StackPanel x:Name="ShoutForm"><TextBlock Text="{local:Tr 'Aviso da comunidade'}" Margin="0,0,0,8"/><TextBox x:Name="ShoutInput" AcceptsReturn="True" TextWrapping="Wrap" Height="100" MaxLength="255" VerticalContentAlignment="Top"/><Button Content="{local:Tr 'Publicar aviso'}" Click="SaveShout_Click" HorizontalAlignment="Left" Margin="0,8,0,20"/></StackPanel><StackPanel x:Name="DescriptionForm"><TextBlock Text="{local:Tr 'Descrição'}" Margin="0,0,0,8"/><TextBox x:Name="DescriptionInput" AcceptsReturn="True" TextWrapping="Wrap" Height="170" MaxLength="1000" VerticalContentAlignment="Top"/><Button Content="{local:Tr 'Salvar descrição'}" Click="SaveDescription_Click" HorizontalAlignment="Left" Margin="0,8,0,8"/></StackPanel></StackPanel></ScrollViewer></TabItem>
    </TabControl>
   </Grid></Border>
  </Grid>
 </Grid>
</UserControl>
