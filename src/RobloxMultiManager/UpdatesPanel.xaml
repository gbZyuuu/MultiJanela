<UserControl FontSize="{DynamicResource Font14}" FontFamily="{DynamicResource InterfaceFontFamily}" x:Class="RobloxMultiManager.UpdatesPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RobloxMultiManager">
    <StackPanel>
        <TextBlock x:Name="CurrentVersion" FontSize="{DynamicResource Font19}" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <WrapPanel><Button Content="{local:Tr 'Verificar atualizações'}" Click="Check_Click"/><Button x:Name="Download" Content="{local:Tr 'Baixar atualização'}" Click="Download_Click" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" Margin="8,0"/><Button x:Name="Open" Content="{local:Tr 'Abrir versão baixada'}" Click="Open_Click" Style="{StaticResource GhostButtonStyle}" IsEnabled="False"/></WrapPanel>
        <Button x:Name="CancelDownload" Content="{local:Tr 'Cancelar'}" Click="CancelDownload_Click" IsEnabled="False" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
        <ProgressBar x:Name="Progress" Height="5" Minimum="0" Maximum="1" Margin="0,14,0,0"/>
        <TextBlock x:Name="Status" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
        <Button Content="{local:Tr 'Instalar para este usuário'}" Click="Install_Click" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
    </StackPanel>
</UserControl>
