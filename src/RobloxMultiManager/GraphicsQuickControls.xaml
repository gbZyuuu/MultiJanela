<UserControl x:Class="RobloxMultiManager.GraphicsQuickControls" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RobloxMultiManager" FontSize="{DynamicResource Font14}">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Text="{local:Tr 'FPS global'}" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/><TextBlock Grid.Column="2" Text="{local:Tr 'Qualidade global'}" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
<ComboBox Grid.Row="1" x:Name="Fps" SelectedValuePath="Tag" SelectionChanged="Value_Changed" AutomationProperties.Name="{local:Tr 'FPS global'}"><ComboBoxItem Content="{local:Tr 'Padrão'}" Tag="-1"/><ComboBoxItem Content="30" Tag="30"/><ComboBoxItem Content="60" Tag="60"/><ComboBoxItem Content="120" Tag="120"/><ComboBoxItem Content="144" Tag="144"/><ComboBoxItem Content="165" Tag="165"/><ComboBoxItem Content="240" Tag="240"/></ComboBox>
<ComboBox Grid.Row="1" Grid.Column="2" x:Name="Quality" SelectedValuePath="Tag" SelectionChanged="Value_Changed" AutomationProperties.Name="{local:Tr 'Qualidade global'}"><ComboBoxItem Content="{local:Tr 'Automática'}" Tag="0"/><ComboBoxItem Content="1" Tag="1"/><ComboBoxItem Content="2" Tag="2"/><ComboBoxItem Content="3" Tag="3"/><ComboBoxItem Content="4" Tag="4"/><ComboBoxItem Content="5" Tag="5"/><ComboBoxItem Content="6" Tag="6"/><ComboBoxItem Content="7" Tag="7"/><ComboBoxItem Content="8" Tag="8"/><ComboBoxItem Content="9" Tag="9"/><ComboBoxItem Content="10" Tag="10"/></ComboBox>
<WrapPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0"><CheckBox x:Name="Enabled" Content="{local:Tr 'Aplicar ao abrir'}" Checked="Enabled_Changed" Unchecked="Enabled_Changed" ToolTip="{local:Tr 'FPS e qualidade são preferências para as próximas aberturas.'}"/><TextBlock Text="{local:Tr 'Durante o jogo, ajuste FPS e qualidade no menu do Roblox.'}" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="10,0,0,0"/><TextBlock x:Name="Status" Foreground="{DynamicResource DangerText}" TextWrapping="Wrap" Margin="10,0,0,0"/></WrapPanel>
</Grid></UserControl>