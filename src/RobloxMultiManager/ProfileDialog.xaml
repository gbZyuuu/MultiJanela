<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RobloxMultiManager.ProfileDialog" WindowStyle="None" Title="{local:Tr 'Perfil de conta'}" Width="470" SizeToContent="Height" ResizeMode="NoResize" Style="{StaticResource AppWindowStyle}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" xmlns:local="clr-namespace:RobloxMultiManager">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource Hairline}" BorderThickness="1">
        <Grid Background="{DynamicResource WindowBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="24,22,24,22">
                <TextBlock Text="{local:Tr 'PERSONALIZAR PERFIL'}" FontSize="{DynamicResource Font14}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Text="{local:Tr 'Seu perfil, do seu jeito'}" Style="{StaticResource PageTitleStyle}" FontSize="{DynamicResource Font21}" />
                <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,4,0,20" Text="{local:Tr 'O nome é apenas local e serve para você identificar a sessão no painel.'}" />
                <TextBlock Text="{local:Tr 'Nome local da conta'}" Style="{StaticResource FieldLabelStyle}" />
                <TextBox x:Name="NameInput" />
                <TextBlock Style="{StaticResource FootnoteStyle}" Margin="0,10,0,0" Text="{local:Tr 'A conta Roblox é identificada automaticamente depois do login e não precisa ser digitada aqui.'}" />
            </StackPanel>
            <Border Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0" Padding="20,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{local:Tr 'Cancelar'}" Style="{StaticResource GhostButtonStyle}" MinWidth="96" Margin="0,0,8,0" Click="CancelButton_Click" />
                    <Button Content="{local:Tr 'Salvar'}" MinWidth="96" IsDefault="True" Click="SaveButton_Click" />
                </StackPanel>
            </Border>
            <Button Grid.Row="0" Style="{StaticResource ChromeCloseButtonStyle}" Tag="{StaticResource GlyphClose}" Width="32" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" ToolTip="{local:Tr 'Cancelar e fechar'}" AutomationProperties.Name="{local:Tr 'Fechar editor de perfil'}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CancelButton_Click" />
        </Grid>
    </Border>
</Window>