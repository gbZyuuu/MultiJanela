<UserControl FontSize="{DynamicResource Font14}" FontFamily="{DynamicResource InterfaceFontFamily}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RobloxMultiManager.ReportPanel" xmlns:local="clr-namespace:RobloxMultiManager">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource SurfaceRaised}" CornerRadius="16" Padding="22" BorderBrush="{DynamicResource GlassBorder}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="{Binding Eyebrow}" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource Font14}" />
                <TextBlock Text="{Binding Title}" FontSize="{DynamicResource Font26}" FontWeight="SemiBold" Margin="0,10,0,8" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource Font14}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Metrics}" Margin="0,16,0,16">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource SurfaceInset}" CornerRadius="10" Padding="14" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Label}" FontSize="{DynamicResource Font14}" Foreground="{DynamicResource TextFaint}" />
                            <TextBlock Text="{Binding Value}" FontSize="{DynamicResource Font15}" FontWeight="SemiBold" Margin="0,7,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Grid.Row="2" Background="{DynamicResource SurfaceInset}" BorderBrush="{DynamicResource GlassBorder}" BorderThickness="1" CornerRadius="12" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{local:Tr 'RELATÓRIO COMPLETO'}" Foreground="{DynamicResource TextFaint}" FontSize="{DynamicResource Font14}" Margin="0,0,0,12" />
                <TextBox Grid.Row="1" Text="{Binding Report, Mode=OneWay}" Style="{StaticResource ConsoleTextStyle}" FontSize="{DynamicResource Font14}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Border>
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="CopyStatus" Foreground="{DynamicResource Success}" FontSize="{DynamicResource Font14}" VerticalAlignment="Center" />
            <Button Content="{local:Tr 'Copiar relatório'}" Click="Copy_Click" HorizontalAlignment="Right" Padding="18,0" />
        </Grid>
    </Grid>
</UserControl>