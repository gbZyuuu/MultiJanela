                                                <ContentPresenter Margin="0,0,28,0" />
                                                <Path Data="M 0 0 L 5 5 L 10 0" Stroke="{DynamicResource TextMuted}" StrokeThickness="1.4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" RenderTransformOrigin="0.5,0.5">
