                                <CheckBox x:Name="AutoArrangeCheck" Content="{local:Tr 'Organizar automaticamente'}" Checked="AutoArrangeCheck_Changed" Unchecked="AutoArrangeCheck_Changed" Margin="0,0,0,14" />
                                <CheckBox x:Name="AutoReconnectCheck" Content="{local:Tr 'Reconectar após queda'}" Checked="AutoReconnectCheck_Changed" Unchecked="AutoReconnectCheck_Changed" Margin="0,0,0,14" ToolTip="{local:Tr 'Reabre somente após uma falha'}" />
                                <TextBlock x:Name="InstallText" Text="{local:Tr 'Roblox: verificando...'}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource Font14}" Margin="0,0,0,14" TextWrapping="Wrap" />
                                <Button x:Name="RepairNativeSessionButton" Content="{local:Tr 'Reparar sessão local do Roblox'}" Click="RepairNativeSession_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Height="42" Padding="16,0" />
                                <TextBlock x:Name="InstallTextDisplay" Text="{Binding Text, ElementName=InstallText}" Visibility="Collapsed" Margin="0,0,0,14" />
                            </StackPanel></StackPanel></Border></StackPanel></ScrollViewer></TabItem><TabItem Header="{local:Tr 'Automação'}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,16,8,0"><Border Style="{StaticResource StudioCardStyle}" Margin="0,0,0,18"><ContentControl x:Name="AutomationSettingsHost" Margin="0,12,0,0"/></Border><Border Style="{StaticResource StudioCardStyle}" Margin="0,0,0,18"><Expander Header="{local:Tr 'Notificações'}" Style="{StaticResource StudioExpanderStyle}"><ContentControl x:Name="NotificationsSettingsHost" Margin="0,12,0,0"/></Expander></Border></StackPanel></ScrollViewer></TabItem><TabItem Header="{local:Tr 'Dados'}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,16,8,0"><Border Style="{StaticResource StudioCardStyle}" Margin="0,0,0,18"><StackPanel><TextBlock Text="{local:Tr 'Backup e restauração'}" FontSize="{DynamicResource Font21}" FontWeight="SemiBold" Margin="0,0,0,14"/><ContentControl x:Name="BackupSettingsHost" Margin="0,12,0,0"/></StackPanel></Border><Border Style="{StaticResource StudioCardStyle}" Margin="0,0,0,18"><StackPanel><TextBlock Text="{local:Tr 'Atualizações e instalação'}" FontSize="{DynamicResource Font21}" FontWeight="SemiBold" Margin="0,0,0,14"/><ContentControl x:Name="UpdatesSettingsHost" Margin="0,12,0,0"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem><TabItem Header="{local:Tr 'Avançado'}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,16,8,0"><Border Style="{StaticResource StudioCardStyle}" Margin="0,0,0,18"><StackPanel><TextBlock Text="{local:Tr 'API local (opcional)'}" FontSize="{DynamicResource Font21}" FontWeight="SemiBold"/><TextBlock Text="{local:Tr 'Conecte ferramentas externas ao gerenciador com permissões que você escolhe.'}" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,8,0,18"/><ContentControl x:Name="LocalApiSettingsHost" Margin="0,12,0,0"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem></TabControl></Grid>
            </Grid>
            <Border x:Name="CommandPaletteHost" Grid.RowSpan="3" Grid.ColumnSpan="2" Background="#E00C0D10" Visibility="Collapsed" MouseLeftButtonDown="OrbitCommandBackdrop_MouseDown" shell:WindowChrome.IsHitTestVisibleInChrome="True" Panel.ZIndex="20">
                <Border Width="560" MaxHeight="460" VerticalAlignment="Top" Margin="0,135,0,0" Style="{StaticResource WorkspacePanelStyle}" BorderBrush="{DynamicResource AccentBorder}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="{local:Tr 'Seu próximo comando.'}" FontSize="{DynamicResource Font22}" FontWeight="SemiBold" />
                            <Button Style="{StaticResource RowCloseButtonStyle}" Tag="{StaticResource IconClose}" HorizontalAlignment="Right" Click="OrbitCommandClose_Click" ToolTip="{local:Tr 'Fechar · Esc'}" />
                        </Grid>
                        <TextBox Grid.Row="1" x:Name="CommandSearchInput" Height="42" FontSize="{DynamicResource Font14}" Margin="0,16,0,12" TextChanged="OrbitCommandSearch_TextChanged" AutomationProperties.Name="{local:Tr 'Buscar comandos e contas'}" />
                        <Grid Grid.Row="2">
                            <ListBox x:Name="CommandResults" Style="{StaticResource CardListStyle}" MaxHeight="280" AutomationProperties.Name="{local:Tr 'Comandos encontrados'}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource GhostButtonStyle}" Height="40" HorizontalContentAlignment="Stretch" Padding="0" Click="OrbitCommandResult_Click">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontSize="{DynamicResource Font14}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Detail}" FontSize="{DynamicResource Font14}" Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="CommandEmptyText" Text="{local:Tr 'Nenhum comando ou conta encontrado.'}" Style="{StaticResource EmptyStateStyle}" Visibility="Collapsed" />
                        </Grid>
                        <TextBlock Grid.Row="3" Text="{local:Tr '↑ ↓ navegar     Enter executar     Esc fechar'}" Foreground="{DynamicResource TextFaint}" FontSize="{DynamicResource Font14}" Margin="0,12,0,0" />
                    </Grid>
                </Border>
            </Border>
            <Border x:Name="Scrim" Grid.RowSpan="3" Grid.ColumnSpan="2" Background="#BA08090B" Opacity="0" Visibility="Collapsed" shell:WindowChrome.IsHitTestVisibleInChrome="True" MouseLeftButtonDown="Scrim_MouseLeftButtonDown" Panel.ZIndex="10" />
            <Border KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" x:Name="DrawerHost" Grid.RowSpan="3" Grid.ColumnSpan="2" Width="620" HorizontalAlignment="Right" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Hairline}" BorderThickness="1,0,0,0" Visibility="Collapsed" shell:WindowChrome.IsHitTestVisibleInChrome="True" Panel.ZIndex="11">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="DrawerShift" X="680" />
                </Border.RenderTransform>
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <StackPanel>
                            <TextBlock x:Name="DrawerTitle" Text="{local:Tr 'Painel'}" Style="{StaticResource PageTitleLargeStyle}" />
                            <TextBlock x:Name="DrawerSubtitle" Style="{StaticResource PageSubtitleStyle}" />
                        </StackPanel>
                        <Button Style="{StaticResource ChromeCloseButtonStyle}" Width="34" Height="30" Tag="{StaticResource GlyphClose}" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="{local:Tr 'Fechar'}" Click="DrawerClose_Click" />
                    </Grid>
                    <ContentControl x:Name="DrawerBody" Grid.Row="1" Margin="0,14,0,0" />
                </Grid>
            </Border>
            <StackPanel Grid.RowSpan="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,0,0" shell:WindowChrome.IsHitTestVisibleInChrome="True" Panel.ZIndex="30">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Visibility, ElementName=DrawerHost}" Value="Visible">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Button Style="{StaticResource ChromeButtonStyle}" Tag="{StaticResource GlyphMinimize}" ToolTip="{local:Tr 'Minimizar'}" Click="ChromeMinimize_Click" />
                <Button Style="{StaticResource ChromeButtonStyle}" Tag="{StaticResource GlyphMaximize}" ToolTip="{local:Tr 'Maximizar ou restaurar'}" Click="ChromeMaximize_Click" />
                <Button Style="{StaticResource ChromeCloseButtonStyle}" Tag="{StaticResource GlyphClose}" ToolTip="{local:Tr 'Fecha para a área de notificação e mantém a trava'}" Click="ChromeClose_Click" />
            </StackPanel>
            <Grid x:Name="SequenceParking" Visibility="Collapsed">
                <TextBlock x:Name="ProcessCountText" Visibility="Collapsed" />
                <TextBlock x:Name="WindowCountText" Visibility="Collapsed" />
                <TextBlock x:Name="TargetCountText" Visibility="Collapsed" />
                <TextBlock x:Name="ConfirmationText" Visibility="Collapsed" />
                <ProgressBar x:Name="TargetProgress" Visibility="Collapsed" />
                <local:InstanceMap x:Name="InstancesGrid" ScrollViewer.VerticalScrollBarVisibility="Visible" ItemsSource="{Binding Instances}" ProfilesSource="{Binding Profiles}" Style="{StaticResource CardListStyle}" ItemContainerStyle="{StaticResource CanvasCardStyle}" SelectionMode="Extended" SelectionChanged="CanvasSelection_Changed" PreviewKeyDown="Canvas_PreviewKeyDown" KeyboardNavigation.DirectionalNavigation="Contained">
                    <local:InstanceMap.ItemsPanel>
                        <ItemsPanelTemplate>
                            <local:SessionTilePanel />
                        </ItemsPanelTemplate>
                    </local:InstanceMap.ItemsPanel>
                    <local:InstanceMap.ItemTemplate>
                        <DataTemplate>
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" MinWidth="170" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="94" />
                                    <ColumnDefinition Width="186" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{local:Tr 'Selecionar sessão'}" />
                                <Grid Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding ProfileText}" FontSize="{DynamicResource Font17}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProfileText}" />
                                        <TextBlock Text="{Binding StatusText}" FontSize="{DynamicResource Font14}" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Border Width="34" Height="34" CornerRadius="6" Background="{DynamicResource SurfaceInset}" HorizontalAlignment="Left">
                                        <Grid>
                                            <TextBlock Text="R" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Width="34" Height="34">
                                                <Image.Source>
                                                    <MultiBinding Converter="{StaticResource SessionAvatar}">
                                                        <Binding />
                                                        <Binding Path="ProfilesSource" RelativeSource="{RelativeSource AncestorType=local:InstanceMap}" />
                                                        <Binding Path="ProfileRevision" RelativeSource="{RelativeSource AncestorType=local:InstanceMap}" />
                                                    </MultiBinding>
                                                </Image.Source>
                                            </Image>
                                        </Grid>
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Column="2" Text="{Binding ProcessId, StringFormat='PID {0}'}" FontSize="{DynamicResource Font17}" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding FileVersion, TargetNullValue=—}" FontSize="{DynamicResource Font15}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileVersion}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="{local:Tr 'Focar'}" Style="{StaticResource SecondaryButtonStyle}" Height="36" Padding="12,0" Click="CanvasFocusRow_Click" IsEnabled="{Binding HasWindow}" />
                                    <Button Content="{local:Tr 'Fechar'}" Style="{StaticResource GhostButtonStyle}" Foreground="{DynamicResource DangerText}" Height="36" Padding="10,0" Margin="4,0,0,0" Click="CanvasCloseRow_Click" />
                                    <Button Content="⋯" Style="{StaticResource GhostButtonStyle}" Width="32" Height="36" Padding="0" FontSize="{DynamicResource Font20}" Click="CanvasDetails_Click" ToolTip="{local:Tr 'Detalhes da sessão'}" AutomationProperties.Name="{local:Tr 'Detalhes da sessão'}" />
                                </StackPanel>
                                <TextBlock Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" ToolTip="{local:Tr 'Tempo desde a abertura do Roblox'}" Grid.Column="4" FontSize="{DynamicResource Font15}">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource SessionTime}">
                                            <Binding Path="StartTimeUtc" />
                                            <Binding Path="ClockUtc" RelativeSource="{RelativeSource AncestorType=local:InstanceMap}" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </local:InstanceMap.ItemTemplate>
                </local:InstanceMap>
                <Border Grid.Column="0" Style="{StaticResource WorkspacePanelStyle}" Background="Transparent" x:Name="NexusLibrary" Grid.RowSpan="1" Grid.Row="1" Visibility="Collapsed" Padding="0" BorderThickness="0" CornerRadius="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource IconAccount}" Width="20" Height="20" Stretch="Uniform" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.4" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,6,0" VerticalAlignment="Center">
                                <TextBlock Text="{local:Tr 'Suas contas'}" FontSize="{DynamicResource Font24}" FontWeight="SemiBold" />
                                <Border Style="{StaticResource ChipStyle}" Background="{DynamicResource AccentSurface}" BorderBrush="Transparent" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding Profiles.Count}" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource Font14}" />
                                </Border>
                            </StackPanel>
                            <Button Grid.Column="2" Content="{local:Tr 'Adicionar conta'}" Height="40" Padding="16,0" Click="AddProfileButton_Click" />
                        </Grid>
                        <Grid Grid.Row="2">
                            <ListBox x:Name="ProfilesGrid" Style="{StaticResource CardListStyle}" ItemsSource="{Binding AccountProfilesView}" SelectionMode="Extended" SelectionChanged="ProfilesGrid_SelectionChanged" AutomationProperties.Name="{local:Tr 'Contas Roblox'}" ItemContainerStyle="{StaticResource CanvasCardStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="42" Height="42">
                                                <Border CornerRadius="10" Background="{DynamicResource AccentSurface}">
                                                    <TextBlock Text="{Binding Name[0]}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" FontSize="{DynamicResource Font14}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <Border CornerRadius="10">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding PublicAvatarUrl, IsAsync=True}" Stretch="UniformToFill" />
                                                    </Border.Background>
                                                </Border>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="10,0,7,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Font17}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding AccountDisplay}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <Ellipse Width="5" Height="5" Margin="0,0,5,0" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{DynamicResource Success}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSignedIn}" Value="False">
                                                                        <Setter Property="Fill" Value="{DynamicResource TextFaint}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock FontSize="{DynamicResource Font14}" Foreground="{DynamicResource TextMuted}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{local:Tr 'Pronta'}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSignedIn}" Value="False">
                                                                        <Setter Property="Text" Value="{local:Tr 'Faça login'}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Tag="{StaticResource IconPlay}" IsEnabled="{Binding IsSignedIn}" ToolTip="{local:Tr 'Abrir o Roblox nesta conta'}" AutomationProperties.Name="{local:Tr 'Abrir Roblox nesta conta'}" Click="LaunchAccountRowButton_Click" Content="{local:Tr 'Abrir conta'}" Width="120" Height="38" Padding="12,0" />
                                            <Button Grid.Column="3" Style="{StaticResource RowPlayButtonStyle}" Tag="{StaticResource OrbitMore}" Width="23" Margin="4,0,0,0" Background="Transparent" BorderBrush="Transparent" ToolTip="{local:Tr 'Ações desta conta'}" AutomationProperties.Name="{local:Tr 'Ações desta conta'}" Click="OrbitAccountActions_Click">
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="{local:Tr 'Login / atualizar sessão'}" Click="LoginProfileButton_Click" />
                                                        <MenuItem Header="{local:Tr 'Editar nome local'}" Click="EditProfileButton_Click" />
                                                        <Separator />
                                                        <MenuItem Header="{local:Tr 'Mover para cima'}" Click="MoveProfileUpButton_Click" />
                                                        <MenuItem Header="{local:Tr 'Mover para baixo'}" Click="MoveProfileDownButton_Click" />
                                                        <Separator />
                                                        <MenuItem Header="{local:Tr 'Remover conta'}" Click="RemoveProfileButton_Click" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel" BasedOn="{StaticResource WorkspaceEmptyStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Profiles.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Width="64" Height="64" CornerRadius="10" Background="{DynamicResource AccentSurface}" HorizontalAlignment="Center" Visibility="Collapsed">
                                    <Path Data="{StaticResource IconAccount}" Stroke="{DynamicResource Accent}" StrokeThickness="1.3" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{local:Tr 'Suas contas ficam aqui'}" FontSize="{DynamicResource Font14}" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,18,0,0" />
                                <TextBlock Text="{local:Tr 'Adicione uma conta para começar.'}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource Font14}" TextAlignment="Center" Margin="0,8,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="AccountSearchEmptyState" Text="{local:Tr 'Nenhuma conta encontrada.&#10;Tente outro nome ou remova o filtro.'}" Style="{StaticResource EmptyStateStyle}" Visibility="Collapsed" Margin="16" />
                        </Grid>
                        <StackPanel Grid.Row="3" Margin="0,12,0,0">
                            <CheckBox x:Name="AccountReadyFilter" Content="{local:Tr 'Somente contas prontas'}" Checked="AccountReadyFilter_Changed" Unchecked="AccountReadyFilter_Changed" />
                            <TextBlock x:Name="AccountResultsText" Text="{local:Tr '0 contas'}" FontSize="{DynamicResource Font14}" Foreground="{DynamicResource TextMuted}" Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Row="0" Background="Transparent" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,0,0,1" CornerRadius="0" Padding="0" Margin="0,0,0,24" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="WorkspaceSessionsTab" GroupName="WorkspacePage" Content="{local:Tr 'Sessões'}" IsChecked="True" Click="ComfortAccounts_Click" Style="{StaticResource ComfortTabStyle}" />
                            <RadioButton x:Name="WorkspaceLibraryTab" GroupName="WorkspacePage" Content="{local:Tr 'Contas'}" Click="ComfortLibrary_Click" Style="{StaticResource ComfortTabStyle}" Margin="8,0,0,0" />
                            <RadioButton x:Name="WorkspaceLaunchTab" GroupName="WorkspacePage" Content="{local:Tr 'Abrir contas'}" Click="ComfortLaunch_Click" Style="{StaticResource ComfortTabStyle}" Margin="6,0,0,0" />
                        </StackPanel>
                        <Grid Grid.Column="2" Width="190" VerticalAlignment="Center" Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="15" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="GuardDot" Width="7" Height="7" Fill="{DynamicResource Warning}" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1" x:Name="GuardStatusText" Text="{local:Tr 'Verificando…'}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource Font14}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>
