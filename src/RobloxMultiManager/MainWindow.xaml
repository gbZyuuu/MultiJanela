                                <Button x:Name="ActivateButton" Content="{local:Tr 'Multi-janela'}" Tag="{StaticResource IconShield}" Style="{StaticResource SecondaryButtonStyle}" Click="ActivateButton_Click" Margin="0,0,0,14" />
