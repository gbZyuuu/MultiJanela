<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:ns3="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RobloxMultiManager.RobloxLaunchWindow" Title="{local:Tr 'Abrindo Roblox'}" Width="590" Height="470" WindowStyle="None" ResizeMode="NoResize" Style="{StaticResource AppWindowStyle}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" xmlns:local="clr-namespace:RobloxMultiManager">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource Hairline}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1" />
            </Grid.RowDefinitions>
            <Grid Margin="26,22,26,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="{local:Tr 'Abrir Roblox'}" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource Font14}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource ChromeCloseButtonStyle}" Width="30" Height="30" Tag="{StaticResource GlyphClose}" HorizontalAlignment="Right" ToolTip="{local:Tr 'Cancelar abertura'}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseButton_Click" />
                </Grid>
                <Grid Grid.Row="1" Margin="0,24,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="62" Height="62" HorizontalAlignment="Left" Background="{DynamicResource AccentSurface}" CornerRadius="18">
                        <Grid>
                            <Path Data="{StaticResource IconPlay}" Width="24" Height="24" Stretch="Uniform" Stroke="{DynamicResource Accent}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding PublicAvatarUrl, IsAsync=True}" Width="58" Height="58" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="LaunchHeadingText" Text="{local:Tr 'Preparando a conta…'}" FontSize="{DynamicResource Font23}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="TitleText" Text="{local:Tr 'Abrindo Roblox'}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource Font14}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                <Border Grid.Row="2" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource GlassBorder}" BorderThickness="1" CornerRadius="14" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{local:Tr 'Andamento'}" FontSize="{DynamicResource Font14}" Foreground="{DynamicResource TextFaint}" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,12">
                            <TextBlock x:Name="StatusText" Text="{local:Tr 'Preparando a autorização da conta…'}" FontSize="{DynamicResource Font14}" TextWrapping="Wrap" />
                        </ScrollViewer>
                        <ProgressBar x:Name="LaunchProgress" Grid.Row="2" Height="4" IsIndeterminate="True" />
                    </Grid>
                </Border>
                <UniformGrid Grid.Row="3" Rows="1" Margin="0,18,0,0">
                    <TextBlock x:Name="StageOne" Text="{local:Tr '1. Sessão'}" FontSize="{DynamicResource Font14}" Foreground="{DynamicResource Accent}" />
                    <TextBlock x:Name="StageTwo" Text="{local:Tr '2. Autorização'}" FontSize="{DynamicResource Font14}" Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="StageThree" Text="{local:Tr '3. Cliente'}" FontSize="{DynamicResource Font14}" Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Right" />
                </UniformGrid>
            </Grid>
            <Border Grid.Row="1" Background="{DynamicResource Surface}" Padding="26,14">
                <Grid>
                    <TextBlock Text="{local:Tr 'Você pode continuar usando o gerenciador.'}" Foreground="{DynamicResource TextFaint}" FontSize="{DynamicResource Font14}" VerticalAlignment="Center" />
                    <Button x:Name="CloseButton" Content="{local:Tr 'Cancelar'}" Style="{StaticResource SecondaryButtonStyle}" MinWidth="100" HorizontalAlignment="Right" Click="CloseButton_Click" />
                </Grid>
            </Border>
            <ns3:WebView2 x:Name="Browser" Grid.Row="2" Height="1" IsHitTestVisible="False" />
        </Grid>
    </Border>
</Window>