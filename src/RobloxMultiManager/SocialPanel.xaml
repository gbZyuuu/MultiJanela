<UserControl FontSize="{DynamicResource Font14}" FontFamily="{DynamicResource InterfaceFontFamily}" x:Class="RobloxMultiManager.SocialPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RobloxMultiManager">
<Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel><Button x:Name="Refresh" DockPanel.Dock="Right" Content="{local:Tr 'Atualizar'}" Click="Refresh_Click" Style="{StaticResource SecondaryButtonStyle}"/><StackPanel><DockPanel><TextBlock x:Name="FriendCount" DockPanel.Dock="Right" Margin="16,6,0,0" Foreground="{DynamicResource TextPrimary}"/><TextBlock x:Name="Title" FontSize="{DynamicResource Font21}" FontWeight="SemiBold"/></DockPanel><TextBlock x:Name="AccountCaption" Foreground="{DynamicResource TextMuted}" Margin="0,4,12,0" TextTrimming="CharacterEllipsis"/></StackPanel></DockPanel>
<TextBlock x:Name="Status" Grid.Row="1" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,12"/>
<Grid Grid.Row="2"><ListBox x:Name="Friends" Style="{StaticResource CardListStyle}" ItemContainerStyle="{StaticResource FocusAccountRowStyle}" SelectionChanged="Friend_Selected" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="6" Background="{DynamicResource SurfaceRaised}" VerticalAlignment="Top"><Grid><TextBlock Text="R" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding ThumbnailUrl, IsAsync=True}"/></Grid></Border><StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="{Binding Caption}" FontSize="{DynamicResource Font16}" FontWeight="SemiBold" TextWrapping="Wrap"/><DockPanel Margin="0,7,0,0"><Border DockPanel.Dock="Left" Width="40" Height="40" Background="{DynamicResource SurfaceRaised}" CornerRadius="5" Margin="0,0,10,0"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding InExperience}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><Image Source="{Binding ExperienceIconUrl, IsAsync=True}"/></Border><TextBlock Text="{Binding ExperienceCaption}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center"><Button Tag="{StaticResource IconPlay}" Style="{StaticResource SecondaryButtonStyle}" Width="38" Height="38" Padding="10,0" VerticalAlignment="Center" IsEnabled="{Binding CanJoin}" ToolTip="{local:Tr 'Entrar no servidor deste amigo'}" AutomationProperties.Name="{local:Tr 'Entrar no servidor deste amigo'}" Click="FriendPlay_Click" HorizontalAlignment="Right"/><WrapPanel Margin="0,8,0,0" HorizontalAlignment="Right" Visibility="{Binding ManagementVisibility, RelativeSource={RelativeSource AncestorType=local:SocialPanel}}"><Button Content="{local:Tr 'Editar apelido'}" Style="{StaticResource GhostButtonStyle}" Click="RowAlias_Click"/><Button Content="{local:Tr 'Remover amizade'}" Style="{StaticResource GhostButtonStyle}" Click="RowRemove_Click"/></WrapPanel></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
<Grid x:Name="OutfitArea" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><ListBox x:Name="Outfits" Style="{StaticResource CardListStyle}" ItemContainerStyle="{StaticResource FocusAccountRowStyle}" SelectionChanged="Outfit_Selected"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="68" Height="68" CornerRadius="6" Background="{DynamicResource SurfaceRaised}"><Grid><TextBlock Text="R" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding ThumbnailUrl, IsAsync=True}"/></Grid></Border><TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="{DynamicResource Font16}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><ScrollViewer Grid.Column="1" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><Border Background="{DynamicResource SurfaceRaised}" CornerRadius="8" Height="154"><Image x:Name="OutfitPreview" Stretch="Uniform"/></Border><TextBlock x:Name="OutfitCaption" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,10,0,0"/><TextBlock Text="{local:Tr 'Selecionar mostra a prévia. Aplicar itens altera apenas os itens equipados; mantém cores, escala e tipo do corpo.'}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></ScrollViewer></Grid>
</Grid>
<StackPanel Grid.Row="3"><Border x:Name="AliasPanel" Visibility="Collapsed" Background="{DynamicResource SurfaceInset}" Padding="12" CornerRadius="8" Margin="0,10,0,0"><StackPanel><TextBlock x:Name="AliasCaption" TextWrapping="Wrap" Margin="0,0,0,8"/><TextBox x:Name="AliasInput" MaxLength="50" MinHeight="38"/><Button x:Name="SaveAlias" Content="{local:Tr 'Salvar apelido no Roblox'}" Click="SaveAlias_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel></Border><WrapPanel Margin="0,14,0,0"><Button x:Name="Stop" Content="{local:Tr 'Cancelar'}" Click="Stop_Click" Style="{StaticResource GhostButtonStyle}" Visibility="Collapsed" Margin="0,0,8,0"/><Button x:Name="UseServer" Content="{local:Tr 'Usar servidor deste amigo'}" Click="UseServer_Click" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="RemoveFriend" Content="{local:Tr 'Remover amizade'}" Click="RemoveFriend_Click" Style="{StaticResource GhostButtonStyle}" Visibility="Collapsed" Margin="0,0,8,0"/><Button x:Name="EditAlias" Content="{local:Tr 'Editar apelido'}" Click="EditAlias_Click" Style="{StaticResource GhostButtonStyle}" Visibility="Collapsed" Margin="0,0,8,0"/><Button x:Name="ViewProfile" Content="{local:Tr 'Perfil e mais opções'}" Click="ViewProfile_Click" Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,0"/><Button x:Name="ApplyOutfit" Content="{local:Tr 'Aplicar itens'}" Click="ApplyOutfit_Click" IsEnabled="False" Visibility="Collapsed" Margin="0,0,8,0"/><Button x:Name="More" Content="{local:Tr 'Carregar mais'}" Click="More_Click" Visibility="Collapsed" Style="{StaticResource GhostButtonStyle}"/></WrapPanel></StackPanel>
</Grid></UserControl>
