<UserControl FontSize="{DynamicResource Font14}" FontFamily="{DynamicResource InterfaceFontFamily}" x:Class="RobloxMultiManager.CpuLimitEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RobloxMultiManager">
    <StackPanel>
        <TextBlock x:Name="ModeText" FontSize="{DynamicResource Font18}" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" />
        <TextBlock Text="{local:Tr 'Percentual da capacidade total de CPU por processo. 100% significa sem limite. Valores baixos podem reduzir a fluidez do jogo.'}" FontSize="{DynamicResource Font14}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,10,0,18" />
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Slider x:Name="LimitSlider" Minimum="1" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="5" ValueChanged="LimitSlider_ValueChanged" VerticalAlignment="Center" Margin="0,0,18,0" AutomationProperties.Name="{local:Tr 'Limite de CPU em porcentagem'}" />
            <TextBox x:Name="PercentInput" Grid.Column="1" Text="100" HorizontalContentAlignment="Center" Height="42" VerticalContentAlignment="Center" TextChanged="PercentInput_TextChanged" AutomationProperties.Name="{local:Tr 'Porcentagem de CPU'}" />
            <TextBlock Text="%" Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="{DynamicResource Font20}" />
        </Grid>
        <TextBlock x:Name="PendingSessionHint" Text="{local:Tr 'Conta fechada. O limite será salvo agora e aplicado quando o Roblox abrir.'}" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,16,0,0" Visibility="Collapsed" />
        <TextBlock x:Name="InheritanceHint" Text="{local:Tr 'Mover o controle ou editar a porcentagem cria um limite próprio. Usar global restaura a herança.'}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,16,0,0" />
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerText}" TextWrapping="Wrap" Margin="0,12,0,0" />
        <WrapPanel Margin="0,14,0,0">
            <Button x:Name="ApplyButton" Content="{local:Tr 'Fechar'}" Click="Close_Click" Height="40" Margin="0,0,10,8" />
            <Button x:Name="UseGlobalButton" Content="{local:Tr 'Usar global'}" Click="UseGlobal_Click" Style="{StaticResource SecondaryButtonStyle}" Height="40" Margin="0,0,0,8" />
        </WrapPanel>
        <TextBlock x:Name="SavedText" Foreground="{DynamicResource Success}" TextWrapping="Wrap" Margin="0,8,0,0" />
    </StackPanel>
</UserControl>
