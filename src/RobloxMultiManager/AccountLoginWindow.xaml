<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:ns3="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RobloxMultiManager.AccountLoginWindow" Title="{local:Tr 'Login oficial do Roblox'}" Width="1060" Height="770" MinWidth="780" MinHeight="580" WindowStyle="None" Style="{StaticResource AppWindowStyle}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" xmlns:local="clr-namespace:RobloxMultiManager">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid Background="{DynamicResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,0,0,1" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{local:Tr 'Adicionar conta'}" FontSize="{DynamicResource Font14}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock x:Name="TitleText" Text="{local:Tr 'Entrar na conta'}" Style="{StaticResource PageTitleStyle}" FontSize="{DynamicResource Font23}" />
                    <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,7,20,0" TextWrapping="Wrap" Text="{local:Tr 'Entre na página oficial abaixo e depois use Concluir login. A senha é digitada somente na página oficial. A sessão deste perfil é preservada.'}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Border Style="{StaticResource ChipStyle}" Padding="9,5" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="14" Height="14" Stretch="None" VerticalAlignment="Center" Margin="0,0,7,0" Data="{StaticResource IconShield}" Stroke="{DynamicResource Success}" StrokeThickness="1.3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <TextBlock x:Name="HostText" Text="roblox.com" Foreground="{DynamicResource Success}" FontSize="{DynamicResource Font14}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource ChromeCloseButtonStyle}" Width="34" Height="30" Margin="12,0,0,0" Tag="{StaticResource GlyphClose}" VerticalAlignment="Center" ToolTip="{local:Tr 'Fechar'}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CancelButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Margin="20,16" Background="#FFFFFF" BorderBrush="{DynamicResource Hairline}" BorderThickness="1" CornerRadius="8" ClipToBounds="True" SnapsToDevicePixels="True">
            <Grid>
                <ns3:WebView2 x:Name="IdentityBrowser" Width="1" Height="1" Visibility="Hidden" IsHitTestVisible="False" Focusable="False" HorizontalAlignment="Left" VerticalAlignment="Top" />
                <ns3:WebView2 x:Name="Browser" />
            </Grid>
        </Border>
        <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0" Padding="24,16">
            <StackPanel>
                <TextBlock x:Name="StatusText" Text="{local:Tr 'Preparando o navegador seguro...'}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" Margin="0,0,0,10" />
                <WrapPanel HorizontalAlignment="Right">
                    <Button x:Name="ReloadButton" Content="{local:Tr 'Recarregar'}" Style="{StaticResource GhostButtonStyle}" IsEnabled="False" Margin="0,0,8,6" Click="ReloadButton_Click" />
                    <Button Content="{local:Tr 'Testar no navegador'}" Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,6" Click="ExternalBrowserButton_Click" />
                    <Button Content="{local:Tr 'Cancelar'}" Style="{StaticResource GhostButtonStyle}" MinWidth="96" Margin="0,0,8,6" Click="CancelButton_Click" />
                    <Button x:Name="DetectButton" Content="{local:Tr 'Concluir login'}" Tag="{StaticResource IconAccount}" IsEnabled="False" Margin="0,0,0,6" Click="DetectButton_Click" />
                </WrapPanel>
                <Expander Header="{local:Tr 'Problemas com login ou verificação?'}" Margin="0,4,0,0">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" Text="{local:Tr 'Se a verificação também falhar no navegador normal, o erro pode estar na conta, na rede ou no Roblox. Verifique data/hora e o acesso a arkoselabs.com e funcaptcha.com. Não repita tentativas continuamente.'}" />
                        <TextBlock Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" Margin="0,6,0,6" Text="{local:Tr 'Diagnóstico local: somente versão do navegador, domínios e códigos de erro; sem senhas, cookies ou tokens. HTTP 403 sozinho não confirma uma restrição.'}" />
                        <ScrollViewer MaxHeight="70" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="DiagnosticText" FontFamily="Consolas" FontSize="{DynamicResource Font12}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" /></ScrollViewer>
                        <Button Content="{local:Tr 'Copiar diagnóstico'}" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="CopyDiagnosticButton_Click" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>
    </Grid>
</Window>