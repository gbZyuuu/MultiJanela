  "(() => {\r\n    const messageNonce = {0};\r\n    const messageSource = {1};\r\n    const expectedUserId = {2};\r\n    const authenticatedUserUrl = {3};\r\n    const assertionUrl = {4};\r\n    const ticketUrl = {5};\r\n    const shareResolveUrl = {6};\r\n    const shareCode = {7};\r\n    let shareStatus = null;\r\n    let sharePlaceId = null;\r\n    let shareLinkCode = null;\r\n    const sendResult = value => window.chrome.webview.postMessage({\r\n        ...value,\r\n        shareStatus,\r\n        sharePlaceId,\r\n        shareLinkCode,\r\n        source: messageSource,\r\n        nonce: messageNonce\r\n    });\r\n    const readCachedCsrf = () => {\r\n        try {\r\n            return localStorage.getItem(\"x-csrf-token\")\r\n                || document.querySelector('meta[name=\"csrf-token\"]')\r\n                    ?.dataset?.token\r\n                || null;\r\n        } catch {\r\n            return null;\r\n        }\r\n    };\r\n    const cacheCsrf = value => {\r\n        try {\r\n            localStorage.setItem(\"x-csrf-token\", value);\r\n        } catch {\r\n            // O fluxo continua sem o cache local.\r\n        }\r\n    };\r\n    const resolveShare = async () => {\r\n        const send = csrf => {\r\n            const headers = {\r\n                \"Accept\": \"application/json\",\r\n                \"Content-Type\": \"application/json\"\r\n            };\r\n            if (csrf) {\r\n                headers[\"X-CSRF-TOKEN\"] = csrf;\r\n            }\r\n            return fetch(shareResolveUrl, {\r\n                method: \"POST\",\r\n                mode: \"cors\",\r\n                credentials: \"include\",\r\n                cache: \"no-store\",\r\n                headers,\r\n                body: JSON.stringify({\r\n                    linkId: shareCode,\r\n                    linkType: \"Server\"\r\n                })\r\n            });\r\n        };\r\n        let response = await send(readCachedCsrf());\r\n        if (response.status === 403) {\r\n            const csrf = response.headers.get(\"x-csrf-token\");\r\n            if (csrf) {\r\n                cacheCsrf(csrf);\r\n                response = await send(csrf);\r\n            }\r\n        }\r\n        if (!response.ok) {\r\n            shareStatus = \"http-\" + response.status;\r\n            return;\r\n        }\r\n        const data = await response.json();\r\n        const invite = data?.privateServerInviteData;\r\n        if (invite == null) {\r\n            shareStatus = \"missing\";\r\n            return;\r\n        }\r\n        shareStatus = invite.status == null\r\n            ? \"unknown\"\r\n            : String(invite.status);\r\n        if (invite.placeId != null) {\r\n            sharePlaceId = String(invite.placeId);\r\n        }\r\n        if (invite.linkCode != null) {\r\n            shareLinkCode = String(invite.linkCode);\r\n        }\r\n    };\r\n    const requestTicket = async (assertion, csrf) => {\r\n        const headers = {\r\n            \"Accept\": \"application/json\",\r\n            \"Content-Type\": \"application/json\"\r\n        };\r\n        if (csrf) {\r\n            headers[\"X-CSRF-TOKEN\"] = csrf;\r\n        }\r\n        return fetch(ticketUrl, {\r\n            method: \"POST\",\r\n            mode: \"cors\",\r\n            credentials: \"include\",\r\n            headers,\r\n            body: JSON.stringify(assertion ?? {})\r\n        });\r\n    };\r\n    (async () => {\r\n        let authenticatedUserId = null;\r\n        try {\r\n            const identityResponse = await fetch(authenticatedUserUrl, {\r\n                method: \"GET\",\r\n                mode: \"cors\",\r\n                credentials: \"include\",\r\n                cache: \"no-store\",\r\n                headers: { \"Accept\": \"application/json\" }\r\n            });\r\n            if (!identityResponse.ok) {\r\n                sendResult({\r\n                    kind: \"ticket-result\",\r\n                    session: \"not-authenticated\",\r\n                    authenticatedUserId: null,\r\n                    status: identityResponse.status,\r\n                    ticket: null\r\n                });\r\n                return;\r\n            }\r\n\r\n            const identity = await identityResponse.json();\r\n            authenticatedUserId = identity?.id == null\r\n                ? null\r\n                : String(identity.id);\r\n            if (!authenticatedUserId) {\r\n                sendResult({\r\n                    kind: \"ticket-result\",\r\n                    session: \"not-authenticated\",\r\n                    authenticatedUserId: null,\r\n                    status: 422,\r\n                    ticket: null\r\n                });\r\n                return;\r\n            }\r\n            if (authenticatedUserId !== expectedUserId) {\r\n                sendResult({\r\n                    kind: \"ticket-result\",\r\n                    session: \"account-mismatch\",\r\n                    authenticatedUserId,\r\n                    status: 409,\r\n                    ticket: null\r\n                });\r\n                return;\r\n            }\r\n        } catch {\r\n            sendResult({\r\n                kind: \"ticket-result\",\r\n                session: \"not-authenticated\",\r\n                authenticatedUserId: null,\r\n                status: 0,\r\n                ticket: null\r\n            });\r\n            return;\r\n        }\r\n\r\n        // Resolved before the ticket is requested: a bad invite must\r\n        // not consume a one-time authorization.\r\n        if (shareCode) {\r\n            try {\r\n                await resolveShare();\r\n            } catch {\r\n                shareStatus = \"network\";\r\n            }\r\n            if (shareStatus !== \"Valid\") {\r\n                sendResult({\r\n                    kind: \"ticket-result\",\r\n                    session: \"verified\",\r\n                    authenticatedUserId,\r\n                    status: 0,\r\n                    ticket: null\r\n                });\r\n                return;\r\n            }\r\n        }\r\n\r\n        let assertion = {};\r\n        try {\r\n            const assertionResponse = await fetch(assertionUrl, {\r\n                method: \"GET\",\r\n                mode: \"cors\",\r\n                credentials: \"include\",\r\n                headers: { \"Accept\": \"application/json\" }\r\n            });\r\n            if (assertionResponse.ok) {\r\n                assertion = (await assertionResponse.json()) ?? {};\r\n            }\r\n        } catch {\r\n            assertion = {};\r\n        }\r\n\r\n        try {\r\n            const initialCsrf =\r\n                localStorage.getItem(\"x-csrf-token\")\r\n                || document.querySelector('meta[name=\"csrf-token\"]')\r\n                    ?.dataset?.token\r\n                || null;\r\n            let response = await requestTicket(assertion, initialCsrf);\r\n            if (response.status === 403) {\r\n                const csrf = response.headers.get(\"x-csrf-token\");\r\n                if (csrf) {\r\n                    try {\r\n                        localStorage.setItem(\"x-csrf-token\", csrf);\r\n                    } catch {\r\n                        // A autorização ainda pode continuar sem cache local.\r\n                    }\r\n                    response = await requestTicket(assertion, csrf);\r\n                }\r\n            }\r\n            sendResult({\r\n                kind: \"ticket-result\",\r\n                session: \"verified\",\r\n                authenticatedUserId,\r\n                status: response.status,\r\n                ticket: response.headers.get(\"rbx-authentication-ticket\") || null\r\n            });\r\n        } catch {\r\n            sendResult({\r\n                kind: \"ticket-result\",\r\n                session: \"verified\",\r\n                authenticatedUserId,\r\n                status: 0,\r\n                ticket: null\r\n            });\r\n        }\r\n    })();\r\n    return true;\r\n})();",
